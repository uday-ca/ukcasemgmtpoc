<?xml version="1.0" encoding="utf-8"?>
<!-- Package source for this repository: nuget.org only, so builds are the same on every machine and in GitHub Actions. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
